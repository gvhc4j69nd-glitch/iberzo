# NewsAPI.org key (free tier works). Without it, the site serves bundled
# sample stories so you can see the UI without any keys configured.
NEWS_API_KEY=

# Anthropic API key, used to rewrite each story neutrally. Without it, the
# site falls back to a plain extractive summary (concatenated descriptions).
ANTHROPIC_API_KEY=

# Optional overrides
PORT=8787
# Comma-separated NewsAPI source IDs to broaden ideological coverage
# beyond the default country=us feed.
NEWS_API_SOURCES=
# Minutes to cache the built story list before refetching/re-summarizing.
STORIES_CACHE_TTL_MINUTES=30
