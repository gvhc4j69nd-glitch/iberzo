# Optional overrides
PORT=8788

# Postgres connection string. When set, league data (teams, rosters,
# available players, your team selection, league config) is persisted to
# this database instead of the local server/data/league.json file, so it
# survives restarts/redeploys without needing to re-import. On Railway,
# reference your Postgres service's DATABASE_URL here; leave unset for
# local dev to use the file-based fallback (no database needed).
DATABASE_URL=
# Set to "disable" only if your Postgres doesn't use SSL (e.g. a local
# instance) — Railway's managed Postgres needs the default (SSL enabled).
PGSSLMODE=

# MyFantasyLeague import defaults — pre-fills the import form. Can also be
# entered directly in the UI each time. No credentials needed for publicly
# viewable leagues.
MFL_LEAGUE_ID=16637
MFL_SEASON=2026
